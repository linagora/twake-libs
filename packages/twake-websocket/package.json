  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@linagora/twake-icons": "^2.13.0",
    "@linagora/twake-mui": "^10.3.0",
    "@mui/lab": "^9.0.0-beta.6",
    "@mui/material": "^9.4.0",
    "@testing-library/react": "16.0.0",
    "@types/react": "^18.3.0",
    "cozy-tsconfig": "^2.0.0",
    "jsdom": "24.1.0",
    "ky": "^1.14.3",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "twake-i18n": "^0.6.0",
