{
  "name": "@linagora/twake-node-server",
  "type": "module",
  "version": "0.0.0",
  "description": "HTTP server, shutdown and Postgres groundwork for Twake Node backends",
  "author": "Twake",
  "license": "MIT",
  "engines": {
    "node": "24.x"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/linagora/twake-libs.git",
    "directory": "packages/twake-node-server"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./postgres": {
      "types": "./dist/postgres.d.ts",
      "import": "./dist/postgres.js"
    }
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "tsc -p tsconfig.build.json --watch",
    "test": "vitest run",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "drizzle-orm": "^1.0.0-rc.4",
    "fastify": "^5.0.0",
    "postgres": "^3.4.0"
  },
  "peerDependenciesMeta": {
    "drizzle-orm": {
      "optional": true
    },
    "postgres": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.0",
    "@types/node": "^24.19.2",
    "cozy-tsconfig": "^2.0.0",
    "drizzle-orm": "1.0.0-rc.4",
    "eslint": "10.2.1",
    "eslint-config-cozy-app": "7.0.0",
    "fastify": "^5.12.5",
    "pino": "^10.4.0",
    "postgres": "^3.4.9",
    "vitest": "5.0.1"
  }
}
