{
  "extends": "cozy-tsconfig",
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ],
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "declarationDir": "./dist",
    "emitDeclarationOnly": false,
    "composite": true,
    "tsBuildInfoFile": "./dist/.tsbuildinfo"
  }
}
